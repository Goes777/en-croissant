{
  "bundle": {
    "active": true,
    "category": "BoardGame",
    "copyright": "",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "publisher": "Goes777",
    "shortDescription": "Chess courses and study tools, based on En Croissant",
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "-"
    },
    "resources": {
      "../sound/": "sound/",
      "../aixchess.duckdb_extension": "aixchess.duckdb_extension",
      "resources/vision/": "vision/"
    },
    "targets": "all",
    "createUpdaterArtifacts": false
  },
  "build": {
    "beforeDevCommand": "pnpm prepare:aix-extension && pnpm start-vite",
    "beforeBuildCommand": "pnpm prepare:aix-extension && pnpm build-vite",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "productName": "ChessPratica",
  "mainBinaryName": "chessimofree",
  "identifier": "io.github.goes777.chessimofree",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "chessimofree"
        ]
      }
    },
    "cli": {
      "args": [
        {
          "name": "file",
          "index": 1,
          "takesValue": true
        }
      ]
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ChessPratica",
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": [
          "**"
        ],
        "enable": true
      },
      "csp": null
    }
  }
}
